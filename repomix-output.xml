    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

/* Ambient Background Animations */
.ambient-bg {
    position: fixed;
    top: -10%;
    left: -10%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, var(--primary-glow) 0%, transparent 60%);
    filter: blur(90px);
    z-index: -1;
    border-radius: 50%;
    animation: floatBg 15s ease-in-out infinite alternate;
}

.ambient-bg-2 {
    position: fixed;
    bottom: -10%;
    right: -10%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(circle, rgba(8, 43, 104, 0.1) 0%, transparent 60%);
    filter: blur(110px);
    z-index: -1;
    border-radius: 50%;
    animation: floatBg2 20s ease-in-out infinite alternate-reverse;
}

@keyframes floatBg {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(50px, 50px) scale(1.1); }
}

@keyframes floatBg2 {
