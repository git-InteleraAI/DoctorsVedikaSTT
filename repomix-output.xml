  font-size: 24px;
  font-weight: 900;
  color: var(--navy-darkest);
  margin: 0 0 4px 0;
  letter-spacing: -0.5px;
}

.auth-card-header p {
  font-size: 14px;
  color: var(--text-slate);
  margin: 0;
  font-weight: 500;
}

/* Alerts */
.auth-alert-box {
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  animation: fadeUp 0.3s forwards;
}

.auth-alert-box.error {
  background-color: #FEF2F2;
  color: #B91C1C;
  border: 1.5px solid #FECACA;
}

.auth-alert-box.success {
  background-color: #F0FDF4;
  color: #15803D;
  border: 1.5px solid #BBF7D0;
}

/* Form Layout */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.auth-form-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.auth-input-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.auth-input-label {
  font-size: 13px;
  font-weight: 700;
  color: var(--navy-darkest);
  margin-left: 2px;
}

/* Premium Field Wrapper */
.auth-input-field-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--input-bg);
  border: 1.5px solid var(--input-border);
  border-radius: 10px;
  height: 42px;
  transition: all 0.3s ease;
  overflow: hidden;
}

.auth-input-field-wrapper:focus-within {
  border-color: var(--teal-primary);
  background: #ffffff;
  box-shadow: 0 0 0 3px var(--teal-glow);
}

/* 3D ICONS */
.auth-input-icon-3d {
  width: 28px;
  height: 28px;
  margin-left: 12px;
  margin-right: 8px;
  object-fit: contain;
  filter: drop-shadow(0 2px 4px rgba(8, 43, 104, 0.15));
  transition: transform 0.3s ease;
}

.auth-input-field-wrapper:focus-within .auth-input-icon-3d {
  transform: scale(1.15) rotate(-5deg);
  filter: drop-shadow(0 4px 8px rgba(8, 174, 184, 0.4));
}

.auth-text-input {
  flex: 1;
  width: 100%;
  height: 100%;
  border: none;
  background: transparent;
  padding: 0 12px 0 4px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
  outline: none;
}

.auth-text-input::placeholder {
  color: #94A3B8;
  font-weight: 400;
  font-size: 13px;
}

.auth-text-input[type="date"]::-webkit-calendar-picker-indicator {
  cursor: pointer;
  padding: 4px;
  filter: invert(45%) sepia(85%) saturate(1500%) hue-rotate(150deg) brightness(95%) contrast(100%);
  transform: scale(1.2);
  margin-right: 8px;
  transition: transform 0.2s ease;
}

.auth-text-input[type="date"]::-webkit-calendar-picker-indicator:hover {
  transform: scale(1.4);
}

.auth-toggle-pwd-btn {
  background: transparent;
  border: none;
  padding: 0 12px;
  color: #64748B;
  cursor: pointer;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Buttons and Links */
.auth-forgot-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -6px;
}

.auth-link-btn {
  background: none;
  border: none;
  color: var(--teal-primary);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
}

.auth-link-btn:hover {
  color: var(--navy-darkest);
  text-decoration: underline;
}

.auth-submit-btn {
  margin-top: 4px;
  width: 100%;
  height: 42px;
  border-radius: 10px;
  background: var(--btn-gradient);
  color: #ffffff;
  font-size: 15px;
  font-weight: 800;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: var(--btn-shadow);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.auth-submit-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 25px -5px rgba(8, 174, 184, 0.5);
}

/* Shimmer Animation on Button */
.auth-submit-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 50%, rgba(255, 255, 255, 0) 100%);
  transform: skewX(-20deg);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% {
    left: -100%;
  }

  20% {
    left: 200%;
  }

  100% {
    left: 200%;
  }
}

.auth-checkbox-label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-slate);
  cursor: pointer;
}

.auth-checkbox {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: var(--teal-primary);
}

.auth-checkbox-label a {
  color: var(--teal-primary);
  text-decoration: none;
  font-weight: 700;
}

.auth-switch-footer {
  margin-top: 12px;
  text-align: center;
  font-size: 13px;
  color: var(--text-slate);
}

.auth-switch-footer a {
  color: var(--teal-primary);
  font-weight: 800;
  text-decoration: none;
  margin-left: 6px;
}

/* Entry Animations */
.animated-entry {
  animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeUp {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  0% {
    opacity: 0;
    transform: translateX(-30px);
  }

  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInUp {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }

  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ECG Graph Animation */
.ecg-container {
  position: absolute;
  width: 200%;
  top: 40%;
  left: 0;
  pointer-events: none;
  display: flex;
  animation: scrollECG 6s linear infinite;
}

.auth-ecg-pulse-animated {
  flex: 1;
}

.auth-ecg-pulse-animated path {
  stroke-dasharray: 600;
  stroke-dashoffset: 600;
  animation: dashFlow 3s linear infinite;
}

@keyframes dashFlow {
  to {
    stroke-dashoffset: 0;
  }
}

@keyframes scrollECG {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(-50%);
  }
}

/* Social Login Button */
.auth-divider {
  display: flex;
  align-items: center;
  margin: 12px 0 8px 0;
  color: #94A3B8;
  font-size: 13px;
  font-weight: 500;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--card-border);
}

.auth-divider span {
  padding: 0 12px;
}

.auth-social-row {
  display: flex;
  width: 100%;
}

.auth-social-btn {
  width: 100%;
  height: 42px;
  border-radius: 10px;
  background: #ffffff;
  border: 1.5px solid var(--card-border);
  color: var(--navy-darkest);
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
}

.auth-social-btn:hover {
  background: #F8FAFC;
  border-color: #CBD5E1;
  transform: translateY(-1px);
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.05);
}

/* ==========================================================================
   MOBILE RESPONSIVENESS OVERRIDES
   ========================================================================== */
@media (max-width: 992px) {
  .doctor-auth-wrapper {
    height: auto;
    min-height: 100vh;
    padding: 80px 20px 40px 20px;
    flex-direction: column;
    align-items: center;
    overflow-y: auto;
  }

  .doctor-auth-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .auth-showcase-panel {
    text-align: center;
    padding-right: 0;
  }

  .auth-showcase-subtitle {
    max-width: 100%;
    margin: 0 auto 12px auto;
  }

  .auth-stage-area {
    display: none;
    /* Hide 3D graphic on small screens to save space */
  }

  .auth-form-card {
    justify-self: center;
    width: 100%;
    max-width: 100%;
  }

  .auth-global-footer-bar {
    position: relative;
    bottom: auto;
    left: auto;
    right: auto;
    width: 100%;
    flex-direction: column;
    gap: 15px;
    margin-top: 20px;
    padding: 15px;
  }

  .auth-footer-divider {
    display: none;
  }

  .auth-footer-info-item {
    justify-content: center !important;
    text-align: center;
    width: 100%;
  }
}

/* ==========================================================================
   SMOOTH 3D OPEN BOOK ANIMATION TRANSITION FOR SIGN-IN PAGE
   ========================================================================== */

.doctor-auth-wrapper {
  perspective: 1500px;
  perspective-origin: 50% 50%;
}

.doctor-auth-container.animated-entry {
  transform-style: preserve-3d;
  animation: bookOpenMaster 0.95s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animated-entry .auth-showcase-panel {
  transform-style: preserve-3d;
  transform-origin: left center;
  animation: bookLeftCoverUnfold 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animated-entry .auth-form-card {
  transform-style: preserve-3d;
  transform-origin: right center;
  animation: bookRightPageUnfold 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  box-shadow: -15px 20px 40px rgba(4, 22, 53, 0.12), 0 0 0 1px rgba(8, 174, 184, 0.15);
}

@keyframes bookOpenMaster {
  0% {
    opacity: 0;
    transform: perspective(1400px) rotateY(-22deg) scale(0.9) translateZ(-80px);
    filter: blur(6px);
  }
  40% {
    opacity: 0.85;
    filter: blur(0px);
  }
  100% {
    opacity: 1;
    transform: perspective(1400px) rotateY(0deg) scale(1) translateZ(0);
    filter: blur(0);
  }
}

@keyframes bookLeftCoverUnfold {
  0% {
    opacity: 0;
    transform: perspective(1200px) rotateY(-38deg) translateX(-30px);
  }
  100% {
    opacity: 1;
    transform: perspective(1200px) rotateY(0deg) translateX(0);
  }
}

@keyframes bookRightPageUnfold {
  0% {
    opacity: 0;
    transform: perspective(1200px) rotateY(30deg) translateX(30px);
  }
  100% {
    opacity: 1;
    transform: perspective(1200px) rotateY(0deg) translateX(0);
  }
}
