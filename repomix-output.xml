const formatTranscriptTimestamp = (ts) => {
    if (!ts) return "";
    const str = String(ts).trim();
    const num = Number(str);
    if (!isNaN(num) && num > 1000000000) {
        try {
            return new Date(num * 1000).toLocaleTimeString("en-IN", {
                hour: "2-digit",
