.qr-chip-btn {
    background: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
}

.qr-chip-btn:hover:not(:disabled) {
    background: #01b6af;
    color: #ffffff;
    border-color: #01b6af;
    transform: translateY(-1px);
}

.qr-chip-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.qr-chip-btn.confirm {
    background: #ecfdf5;
    color: #065f46;
    border-color: #a7f3d0;
}

.qr-chip-btn.confirm:hover:not(:disabled) {
    background: #059669;
    color: #ffffff;
    border-color: #059669;
}

.qr-intake-composer {
    padding: 14px 20px;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
}

.qr-intake-form {
    display: flex;
    gap: 10px;
    align-items: center;
}

.qr-intake-input {
    flex: 1;
    padding: 12px 18px;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    font-size: 14.5px;
    outline: none;
    transition: border-color 0.15s;
    background: #ffffff;
    color: #0f172a;
}

.qr-intake-input:focus {
    border-color: #01b6af;
    box-shadow: 0 0 0 3px rgba(1, 182, 175, 0.12);
}

.qr-intake-send-btn {
