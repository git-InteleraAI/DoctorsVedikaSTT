    if (isNaN(start)) return "--";
    const end = endIso ? new Date(endIso).getTime() : Date.now();
    if (isNaN(end)) return "--";
    const diffMs = Math.max(0, end - start);
    const totalSecs = Math.floor(diffMs / 1000);
