    border-radius: 20px;
    padding: 32px;
    text-align: center;
    max-width: 520px;
    width: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    border: 1px solid #e2e8f0;
}

.qr-success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #ecfdf5;
    color: #059669;
    font-size: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
}

.qr-loading-container,
.qr-error-container {
    background: #ffffff;
    border-radius: 20px;
    padding: 36px 32px;
    text-align: center;
    max-width: 460px;
    width: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    border: 1px solid #e2e8f0;
}
