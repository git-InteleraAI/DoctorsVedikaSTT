                                                    <div style={{ fontSize: "0.7rem", color: "#94a3b8" }}>{chatDate(attQ.created_at)} • Click to open</div>
                                                </div>
                                            </a>
                                        ))}
                                    </div>
                                </section>
                            )}

                            {/* Conversation Info */}
