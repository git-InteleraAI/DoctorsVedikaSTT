/* ==========================================================================
   DOCTORS VEDIKA 4.0 - NO-SCROLL PREMIUM SAAS SYSTEM
   Theme: High Contrast, Dynamic Animations, 100vh Perfect Fit
   ========================================================================== */

:root {
  --navy-darkest: #041635;
  --navy-deep: #082B68;
  --navy-primary: #0B2E6D;
  --teal-primary: #08AEB8;
  --teal-hover: #06929A;
  --teal-light: #DDF7FB;
  --teal-glow: rgba(8, 174, 184, 0.3);

  --text-dark: #071731;
  --text-slate: #334155;
  --text-muted: #64748B;

  --bg-color: #F3FAFE;
  --card-white: #FFFFFF;
  --card-border: #E2E8F0;
  --input-bg: #F8FAFC;
  --input-border: #CBD5E1;

  --btn-gradient: linear-gradient(135deg, #08AEB8 0%, #082B68 100%);
  --btn-shadow: 0 8px 20px -5px rgba(8, 174, 184, 0.4);
}

* {
  box-sizing: border-box;
}

/* MAIN WRAPPER */
.doctor-auth-wrapper {
  height: 100vh;
  width: 100vw;
  background: radial-gradient(circle at top left, #EBF5FC 0%, var(--bg-color) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40px;
  position: relative;
  color: var(--text-dark);
  overflow: hidden;
}

/* BACKGROUND ANIMATIONS */
.auth-ambient-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: 1;
}

.glow-1 {
  width: 450px;
  height: 450px;
  background: rgba(8, 174, 184, 0.15);
  top: -100px;
  left: -50px;
  animation: pulseBlob 8s ease-in-out infinite alternate;
}

.glow-2 {
  width: 500px;
  height: 500px;
  background: rgba(8, 43, 104, 0.1);
  bottom: -150px;
  right: -50px;
  animation: pulseBlob 10s ease-in-out infinite alternate-reverse;
}

.auth-floating-plus {
  position: absolute;
  color: var(--teal-primary);
  font-size: 24px;
  opacity: 0.3;
  pointer-events: none;
  user-select: none;
}

.p1 {
  top: 15%;
  left: 35%;
  animation: floatPlus 6s infinite;
}

.p2 {
  bottom: 25%;
  left: 10%;
  animation: floatPlus 8s infinite reverse;
}

@keyframes pulseBlob {
  0% {
    transform: scale(1) translate(0, 0);
  }

  100% {
    transform: scale(1.1) translate(20px, 20px);
  }
}

@keyframes floatPlus {

  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }

  50% {
    transform: translateY(-15px) rotate(45deg);
  }
}

/* ABSOLUTE TOP LEFT BRANDING */
.auth-top-left-brand {
  position: absolute;
  top: 16px;
  left: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 50;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  padding: 6px 12px;
  border-radius: 12px;
  box-shadow: 0 8px 25px rgba(8, 43, 104, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.5);
  animation: slideInLeft 0.8s ease-out;
  cursor: pointer;
  text-decoration: none;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.auth-top-left-brand:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(8, 43, 104, 0.12);
}

.auth-brand-logo-img {
  height: 62px;
  width: auto;
  object-fit: contain;
}

.auth-brand-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.auth-brand-title {
  font-size: 22px;
  font-weight: 900;
  color: var(--navy-darkest);
  letter-spacing: -0.5px;
  line-height: 1;
}

.auth-brand-title span {
  color: var(--teal-primary);
}

.auth-brand-subtitle {
  font-size: 11px;
  font-weight: 700;
  color: var(--teal-primary);
  letter-spacing: 2px;
  text-transform: uppercase;
