  color: #64748b;
}

.status-tabs-container {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #f1f5f9;
  padding: 4px;
  border-radius: 12px;
  overflow-x: auto;
}

.tab-btn {
  padding: 8px 16px;
  border-radius: 9px;
  border: none;
  font-size: 0.85rem;
  font-weight: 600;
  color: #64748b;
  background: transparent;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
