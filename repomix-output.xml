    frequency: "",
    duration: "",
    instructions: "",
});


const formatDate = (dateValue) => {
    if (!dateValue) {
        return "Not available";
    }

    try {
        return new Date(dateValue)
            .toLocaleDateString(
                "en-IN",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                }
            );
