                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                </Section>

                {/* COMPLETE TRANSCRIPT */}
                {transcript.length > 0 && (
                    <Section title="Consultation Transcript">
                        <div style={{ display: "grid", gap: 10 }}>
