  padding: 0 38px 0 40px;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  font-size: 0.9rem;
  color: #0f172a;
  background: #f8fafc;
  outline: none;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.search-input-group input:focus {
  border-color: #01b6af;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(1, 182, 175, 0.15);
}

.search-input-group .clear-search-btn {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  padding: 4px;
}

