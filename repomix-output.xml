        return pName.includes(q) || pPhone.includes(q) || pCode.includes(q) || docName.includes(q) || token.includes(q) || apptTime.includes(q);
      }

      return true;
    });
  }, [filteredQueue, activeQueueStatusTab, queueSearchText]);

  const filteredAppointments = useMemo(() => {
