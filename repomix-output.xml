};


/* ==========================================================================
   MAIN COMPONENT
========================================================================== */

const ConsultationSummary = () => {

    const location = useLocation();

    const navigate = useNavigate();


    /* ----------------------------------------------------------------------
       Patient ID
    ---------------------------------------------------------------------- */

    const pathParts =
        location.pathname
            .split("/")
            .filter(Boolean);

    const patientIdFromPath =
        pathParts.length >= 2
            ? pathParts[1]
            : "";


    /* ----------------------------------------------------------------------
       Read stored consultation
    ---------------------------------------------------------------------- */

