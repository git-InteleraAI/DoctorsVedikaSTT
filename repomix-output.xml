.qr-critical-banner {
    background: #fef2f2;
    border: 2px solid #ef4444;
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    margin: 16px;
}

.qr-critical-icon {
    font-size: 40px;
    color: #dc2626;
    margin-bottom: 12px;
}

.qr-critical-title {
    font-size: 20px;
    font-weight: 800;
    color: #991b1b;
    margin: 0 0 10px 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.qr-critical-message {
    font-size: 15px;
    line-height: 1.6;
    color: #7f1d1d;
    margin: 0 0 18px 0;
}

.qr-critical-action-btn {
    display: inline-block;
    background: #dc2626;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    padding: 12px 28px;
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
