    if (pwdNew.length < 6) {
      setPwdMsg({ text: "Password must be at least 6 characters long.", type: "error" });
      return;
    }
    setPwdLoading(true);
    try {
      const res = await fetch(`${getApiBaseUrl()}/api/auth/change-password`, {
