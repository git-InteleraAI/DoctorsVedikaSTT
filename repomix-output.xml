                            >
                                {isLoading ? "Updating..." : `Yes, ${statusConfirmModal.targetStatus === "inactive" ? "Deactivate" : "Activate"}`}
                            </button>
                        </div>
                    </div>
                </div>
            )}

        </DashboardLayout>
    );
}
