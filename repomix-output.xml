            { patterns: ["pantocid", "pantoprazole", "pan 40", "ప్యాంటోసిడ్", "పాంతో"], name: "Pantocid 40 mg", dosage: "1 Tablet", defaultFreq: "1-0-0 (Once daily before breakfast)", instructions: "Take on an empty stomach in the morning" },
