<file path="public/css/dashboard.css">
:root {
    --bg-dark: #0a0a0f;
    --card-bg: rgba(20, 20, 30, 0.6);
    --glass-border: rgba(255, 255, 255, 0.08);
    --primary: #00d2ff;
    --primary-glow: rgba(0, 210, 255, 0.3);
    --success: #00ff88;
    --danger: #ff3366;
    --text-main: #f0f0f5;
    --text-muted: #8a8a9d;
    --font-main: 'Outfit', sans-serif;
}

body {
    background-color: var(--bg-dark);
    background-image: url('../images/hologram.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-blend-mode: overlay;
    color: var(--text-main);
    font-family: var(--font-main);
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

/* Ambient Background */
.ambient-bg {
    position: fixed;
    top: -20%;
    left: -10%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle, var(--primary-glow) 0%, transparent 70%);
    filter: blur(100px);
    z-index: -1;
    border-radius: 50%;
}

.ambient-bg-2 {
    position: fixed;
    bottom: -20%;
    right: -10%;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(0, 255, 136, 0.1) 0%, transparent 70%);
    filter: blur(120px);
    z-index: -1;
    border-radius: 50%;
}

/* Portal Layout */
.portal-container {
    display: flex;
    height: 100vh;
}

/* Sidebar */
.sidebar {
    width: 260px;
    background: rgba(10, 10, 15, 0.8);
    border-right: 1px solid var(--glass-border);
    backdrop-filter: blur(10px);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
}

.brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.brand i {
    color: var(--primary);
}

.nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.nav-links li a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 500;
    padding: 12px 16px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
}

.nav-links li a:hover,
.nav-links li a.active {
    background: rgba(255, 255, 255, 0.05);
    color: white;
}

.nav-links li a.active {
    border-left: 3px solid var(--primary);
    background: linear-gradient(90deg, rgba(0, 210, 255, 0.1) 0%, transparent 100%);
}

/* Main Content Area */
.main-content {
    flex: 1;
    padding: 2rem 3rem;
    overflow-y: auto;
}

.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.header-top h1 {
    font-size: 2rem;
    margin: 0;
}

.doctor-profile {
    display: flex;
    align-items: center;
    gap: 15px;
    background: var(--card-bg);
    padding: 8px 16px;
    border-radius: 30px;
    border: 1px solid var(--glass-border);
}

.doctor-profile img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

/* Cards & Containers */
.glass-panel {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 2rem;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.panel-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
}

/* Filters */
.filters-bar {
    display: flex;
    gap: 10px;
}

.filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.3s;
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--primary);
    color: #000;
    border-color: var(--primary);
    box-shadow: 0 0 15px var(--primary-glow);
}

.calendar-picker {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 8px 16px;
    border-radius: 8px;
    font-family: inherit;
    color-scheme: dark;
}

/* Lists */
.request-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.request-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.2s, box-shadow 0.2s;
}

.request-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.1);
}

.patient-info {
    display: flex;
    align-items: center;
    gap: 15px;
}

.patient-info img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
}

.patient-details h4 {
    margin: 0 0 5px 0;
    font-size: 1.1rem;
}

.patient-details p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.request-actions {
    display: flex;
    gap: 10px;
}

.btn {
    padding: 8px 20px;
    border-radius: 8px;
    border: none;
    font-family: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
}

.btn-accept {
    background: var(--success);
    color: #000;
}

.btn-accept:hover {
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.4);
}

.btn-start {
    background: var(--primary);
    color: #000;
}

.btn-start:hover {
    box-shadow: 0 0 15px var(--primary-glow);
}

/* Consultation Page specific */
.consultation-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2rem;
    height: calc(100vh - 120px);
}

.patient-sidebar {
    background: var(--card-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.patient-sidebar img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin-bottom: 1rem;
}

.vitals-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
    margin-top: 1.5rem;
}

.vital-box {
    background: rgba(0, 0, 0, 0.3);
    padding: 10px;
    border-radius: 8px;
    text-align: center;
}

.vital-box span {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
}

.vital-box strong {
    font-size: 1.1rem;
    color: var(--primary);
}

.workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.transcription-box {
    flex: 1;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 1.5rem;
    position: relative;
    overflow-y: auto;
}

.recording-indicator {
    position: absolute;
    top: 15px;
    right: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--danger);
    font-weight: 600;
    font-size: 0.9rem;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }

    100% {
        opacity: 1;
    }
}

.ai-summary-box {
    background: linear-gradient(145deg, rgba(20, 20, 30, 0.9), rgba(10, 10, 15, 0.9));
    border: 1px solid var(--primary);
    box-shadow: 0 0 20px rgba(0, 210, 255, 0.1);
    border-radius: 12px;
    padding: 1.5rem;
}

.ai-summary-box h3 {
    margin-top: 0;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 10px;
}

.summary-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

.input-group label {
    display: block;
    margin-bottom: 5px;
    color: var(--text-muted);
    font-size: 0.9rem;
}

.input-group textarea,
.input-group input {
    width: 100%;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: white;
    padding: 10px;
    font-family: inherit;
}

.action-bar {
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    margin-top: 1rem;
}

.btn-secondary {
    background: transparent;
    border: 1px solid var(--glass-border);
    color: white;
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
}

/* Animations */
.fade-in {
    animation: fadeIn 0.5s ease-in forwards;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ==========================================================================
   CONSULTATION SUMMARY STYLES
   ========================================================================== */

.consultation-summary-page {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: rgba(10, 14, 26, 0.94);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(0, 210, 255, 0.25);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(0, 210, 255, 0.15);
    color: #f0f0f5;
}

.summary-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 210, 255, 0.2);
    border-radius: 16px;
    padding: 1.25rem 2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

.title-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 5px;
}

.title-row h1 {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    color: #ffffff;
}

.ai-badge {
    background: linear-gradient(135deg, rgba(0, 210, 255, 0.2), rgba(0, 255, 136, 0.2));
    border: 1px solid var(--primary);
    color: var(--primary);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
}

.back-button,
.print-button {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    transition: all 0.2s ease;
}

.back-button:hover,
.print-button:hover {
    background: rgba(0, 210, 255, 0.2);
    border-color: var(--primary);
}

.review-banner {
    display: flex;
    align-items: center;
    gap: 15px;
    background: rgba(0, 210, 255, 0.08);
    border: 1px solid rgba(0, 210, 255, 0.3);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
    color: #f0f0f5;
}

.review-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 210, 255, 0.2);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.1rem;
}

.meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
    margin-bottom: 2rem;
}

.meta-card {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 1rem 1.2rem;
}

.meta-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.meta-value {
    font-size: 1.1rem;
    font-weight: 600;
