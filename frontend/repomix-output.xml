                                                "var(--text-muted)",
                                            fontSize:
                                                "0.85rem",
                                        }}
                                    >
                                        {isListening
                                            ? "Listening..."
                                            : isGeneratingSummary
                                                ? "Generating final consultation report..."
                                                : "Microphone inactive"}
                                    </span>

                                </div>


                                <div
                                    style={{
