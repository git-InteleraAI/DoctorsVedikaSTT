                                        }}
                                    >
                                        • {item}
                                    </p>
                                )
                            )}

                        </div>

                    </aside>


                    {/* ====================================================
                        WORKSPACE
                    ==================================================== */}

                    <div className="workspace">

                        <div className="transcription-box">

                            {/* HEADER */}

                            <div
                                style={{
                                    display:
                                        "flex",
                                    alignItems:
                                        "center",
                                    gap: "10px",
                                    marginBottom:
                                        "20px",
                                }}
                            >

                                <i
                                    className="fa-solid fa-microphone"
                                    style={{
                                        fontSize:
                                            "24px",
                                        color:
                                            isListening
                                                ? "var(--primary)"
                                                : "#666",
                                    }}
                                ></i>


                                <div>

                                    <h3
                                        style={{
                                            margin: 0,
                                        }}
                                    >
                                        Live Transcription
                                    </h3>

                                    <span
                                        style={{
