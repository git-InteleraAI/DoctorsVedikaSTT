    border: 1px solid rgba(0, 210, 255, 0.3);
    color: var(--primary);
    border-radius: 8px;
    padding: 8px 16px;
    cursor: pointer;
    font-weight: 600;
    margin-top: 10px;
}

/* Missing Form Grid & Alignment Styles */
.editable-list { display: grid; gap: 10px; }
