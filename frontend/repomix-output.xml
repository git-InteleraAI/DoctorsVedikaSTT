                                    )}


                                {isRecording && (

                                    <button
                                        className="btn btn-secondary"
                                        onClick={
                                            endConsultation
                                        }
                                        style={{
                                            padding:
                                                "12px 25px",
                                        }}
                                    >

                                        <i className="fa-solid fa-stop"></i>
                                        &nbsp;

                                        End Consultation

                                    </button>

                                )}


                                {isGeneratingSummary && (

                                    <div
                                        style={{
                                            textAlign:
                                                "center",
                                            color:
                                                "var(--primary)",
                                        }}
                                    >

                                        <i className="fa-solid fa-spinner fa-spin"></i>

                                        <span
                                            style={{
                                                marginLeft:
                                                    "10px",
                                            }}
                                        >
                                            Processing the
                                            complete
                                            consultation
                                            audio and
                                            generating
                                            the AI report...
                                        </span>

                                    </div>

                                )}

                            </div>

                        </div>

                    </div>

                </div>

            </main>

        </div>
    );
};

export default Consultation;
