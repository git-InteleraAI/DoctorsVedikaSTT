                                            Listening...
                                        </div>
                                        <div style={{ fontSize: "1.05rem", lineHeight: "1.6", opacity: 0.8, fontStyle: "italic" }}>
                                            {liveInterimText}
                                        </div>
                                    </div>
                                )}

                            </div>


                            {/* ====================================================
                                CONTROLS
                            ==================================================== */}

                            <div
                                style={{
                                    marginTop:
                                        "20px",
                                    paddingTop:
                                        "20px",
                                    borderTop:
                                        "1px solid var(--glass-border)",
                                    display:
                                        "flex",
                                    justifyContent:
                                        "center",
                                }}
                            >

                                {!isRecording &&
                                    !isGeneratingSummary && (

                                        <button
                                            className="btn btn-accept"
                                            onClick={
                                                startConsultation
                                            }
                                            style={{
                                                padding:
                                                    "12px 25px",
                                            }}
                                        >

                                            <i className="fa-solid fa-play"></i>
                                            &nbsp;

                                            Start Consultation

